# Copy to frontend/.env to override defaults. All values are PUBLIC (see src/config.ts).
# No secrets belong here.

# Contract address deployed by `npm run deploy` at the repo root.
# Current example targets the Preview network.
VITE_CONTRACT_ADDRESS=f0b1e31ef61b6d10df27396667ee666e77c4f94d52fa09f3dfd1b3ec90d854e7

# Network id passed to the wallet's connect() (wallet-defined for non-mainnet).
VITE_NETWORK_ID=preview

# Proof server used when the wallet does not advertise one (getConfiguration().proverServerUri).
# The local proof server (docker compose) listens on 6300.
VITE_PROOF_SERVER_URL=http://localhost:6300

# Fallback indexer endpoints when the wallet does not advertise its own.
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# How often the public ledger is re-polled (ms).
# VITE_LEDGER_POLL_MS=5000

# Optional: block-explorer base URL used for transaction links in the app.
# "{txId}" (any casing) is replaced with the transaction id, e.g.:
#   VITE_EXPLORER_URL=https://explorer.preview.midnight.network/transactions/{txId}
# Leave unset to hide explorer links entirely.
